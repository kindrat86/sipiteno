{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:country/:service",
      "destination": "/:country/:service/index.html"
    },
    {
      "source": "/integrations/:slug",
      "destination": "/integrations/:slug/index.html"
    },
    {
      "source": "/pricing-questions/:slug",
      "destination": "/pricing-questions/:slug/index.html"
    },
    {
      "source": "/learn/:slug",
      "destination": "/learn/:slug/index.html"
    },
    {
      "source": "/use-cases/:slug",
      "destination": "/use-cases/:slug/index.html"
    },
    {
      "source": "/free/:slug",
      "destination": "/free/:slug/index.html"
    },
    {
      "source": "/api/a2a",
      "destination": "/api/a2a"
    },
    {
      "source": "/api/nlweb",
      "destination": "/api/nlweb"
    },
    {
      "source": "/alternatives-to/:slug",
      "destination": "/alternatives-to/:slug.html"
    },
    {
      "source": "/alternatives",
      "destination": "/index.html"
    },
    {
      "source": "/alternatives/",
      "destination": "/index.html"
    },
    {
      "source": "/vs/:slug",
      "destination": "/vs/:slug.html"
    },
    {
      "source": "/for/:slug",
      "destination": "/for/:slug.html"
    },
    {
      "source": "/glossary/:slug",
      "destination": "/glossary/:slug.html"
    },
    {
      "source": "/best/:slug",
      "destination": "/best/:slug/index.html"
    },
    {
      "source": "/how-to/:slug",
      "destination": "/how-to/:slug/index.html"
    },
    {
      "source": "/business/:slug",
      "destination": "/business/:slug/index.html"
    },
    {
      "source": "/roi-calculator/:slug",
      "destination": "/roi-calculator/:slug/index.html"
    },
    {
      "source": "/research/:slug",
      "destination": "/research/:slug/index.html"
    },
    {
      "source": "/industries/:slug",
      "destination": "/industries/:slug/index.html"
    },
    {
      "source": "/cost-analysis/:slug",
      "destination": "/cost-analysis/:slug/index.html"
    },
    {
      "source": "/hire/:slug",
      "destination": "/hire/:slug/index.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/citations",
      "destination": "/citations.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/answers",
      "destination": "/answers.html"
    },
    {
      "source": "/AGENTS.md",
      "destination": "/agents.md"
    },
    {
      "source": "/agents.md",
      "destination": "/agents.md"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://sipiteno.com"
        },
        {
          "key": "Vary",
          "value": "Origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://eu.i.posthog.com https://us.i.posthog.com https://www.clarity.ms https://scripts.clarity.ms https://snap.licdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co https://eu.i.posthog.com https://us.i.posthog.com https://eu-assets.i.posthog.com https://us-assets.i.posthog.com https://www.clarity.ms https://e.clarity.ms https://report.clarity.ms https://px.ads.linkedin.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://sipiteno.com"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|svg|ico|webp|woff2|woff|ttf|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt|llms\\.txt|llms-full\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/auth",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}